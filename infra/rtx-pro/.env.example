# Copy to .env on your RTX Pro box (never commit .env)

# NVIDIA NGC key for pulling Nemotron NIM: https://org.ngc.nvidia.com/setup/api-key
NGC_API_KEY=

# NVFP4 is the practical default on RTX Pro (Blackwell/Ampere/Hopper)
NIM_MODEL_PROFILE=nvfp4

# LiteLLM local gateway auth (used by worker-side scripts only)
LITELLM_MASTER_KEY=sk-rtx-local-change-me

# Cursor Enterprise service account key (pool workers only — not personal keys)
# Create at: https://cursor.com/dashboard → Service Accounts
CURSOR_API_KEY=

# Worker pool name — must match triggers: pool=rtx-pro
CURSOR_WORKER_POOL_NAME=rtx-pro

# Primary repo this worker serves (clone target)
WORKER_REPO_URL=https://github.com/dannyknightgc78-cloud/enterprise.git
WORKER_ROOT=/opt/cursor-workers/enterprise
