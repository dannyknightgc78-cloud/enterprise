[Unit]
Description=Nemotron 3.5 NIM + LiteLLM relay (RTX Pro)
After=docker.service nvidia-persistenced.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/cursor-workers/enterprise/infra/rtx-pro
EnvironmentFile=-/opt/cursor-workers/enterprise/infra/rtx-pro/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
